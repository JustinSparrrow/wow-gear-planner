# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.idea/
.vscode/

# SQLite 的临时文件
data/wowgear.db-wal
data/wowgear.db-shm

# `data/wowgear.db` 特意入库（5MB）。它是构建产物，但要重建得先拉 61MB 静态数据、
# 再跑 build_db，别人 clone 下来只是想试一下的话成本太高。
# 自带一份建好的，`python main.py` 就能跑；数据过期时再 `--update` 重建。
# 代价是每次 --build 都会改这个文件，提交时注意别看花眼。
data/icons/
data/icon_failures.json

# 原始数据 57MB，首次运行前用 fetch_static.py 拉取。
# 注意这里用 data/raw/* 而不是 data/raw/ ——git 的规则是「父目录被排除后，
# 里面的文件再写 ! 也白搭」，必须先排除内容、再逐个放行。
data/raw/*
# 下面这些是自抓或人工整理的，重拉不回来，必须入库
!data/raw/gems.json
!data/raw/enchants.json
!data/raw/sockets.json
!data/raw/spec_mastery.json
!data/raw/spec_stats.json
!data/raw/rating_curves.json
!data/raw/class_base.json
!data/raw/names_zhcn.json
!data/raw/permanent-enchant.inc

# 临时
*.png
!data/icons/**/*.png
# 入口页底图是成品美术资源，没法重新生成，得入库
!src/web/img/*.png
!src/web/img/*.jpg

# 账号库（密码哈希、历史、存档），绝对不能入库
data/accounts.db

# 真实角色的 /simc 导出，含角色名和服务器，只在本机当样例用
tests/my_profile.txt

# 打包产物（tools/package_beta.py 生成）
dist/

# WorkBuddy 的工作区：开发日志、截图探针、临时脚本。
# 只在本机用，留着是给自己看的，推上去对别人没有意义
.workbuddy/

# 玩家自己填的游戏面板和自选属性。程序生成、每人不同，
# 推上去等于把别人的角色数据带上（评级、耐力这些）
data/panel.json
data/player_crafted.json

# SimC 的源码片段。留着是为了本地查公式方便，但那是 GPL-3.0 的代码，
# 整份复制进仓库会让许可变得麻烦。要看的人照 ref/README.md 去上游拿
ref/*.cpp
ref/*.hh
ref/*.hpp
